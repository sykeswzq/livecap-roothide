#!/bin/sh
# postinst：预写默认配置 + 让设置面板能改写 filter + 刷新注入缓存
LOG=/var/mobile/Documents/livecap_install.log
mkdir -p /var/mobile/Documents
chmod 777 /var/mobile/Documents
echo "=== postinst $(date) ===" > "$LOG"

# 默认配置（面板与 tweak 共用 /var/mobile/Library/Preferences/com.sykes.livecap.plist）
CFG=/var/mobile/Library/Preferences/com.sykes.livecap.plist
if [ ! -f "$CFG" ]; then
  cat > "$CFG" << 'CFGEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>enabled</key>
	<true/>
	<key>sourceLang</key>
	<string>en-US</string>
	<key>targetLang</key>
	<string>zh-CN</string>
	<key>apiBase</key>
	<string>https://apihub.agnes-ai.cn/v1</string>
	<key>apiKey</key>
	<string>sk-ZunoSlgppZBgp19GwuQe6OiJiO2427oGnP4J60Ny30pS0n19</string>
	<key>model</key>
	<string>agnes-3.0-flash</string>
	<key>fontSize</key>
	<string>16</string>
	<key>boldText</key>
	<false/>
	<key>textColorHex</key>
	<string>#FFFFFFFF</string>
	<key>backgroundStyle</key>
	<string>frost</string>
	<key>manualPositions</key>
	<dict/>
	<key>tencentSecretId</key>
	<string></string>
	<key>tencentSecretKey</key>
	<string></string>
</dict>
</plist>
CFGEOF
  chmod 666 "$CFG"
  echo "config written" >> "$LOG"
fi

# 腾讯云密钥由用户在设置面板填写（或 ssh 直写 plist），不硬编码进公开仓库
if [ -f "$CFG" ]; then
  chmod 666 "$CFG"
  echo "config ensured" >> "$LOG"
fi

# 面板写入后 cfprefsd 缓存问题：强制重读，保证面板/tweak 读到的都是最新
killall -9 cfprefsd 2>/dev/null || true

# roothide 注入要求 dylib 归属 mobile:staff；dpkg 默认安装为 root:wheel，此处修正
DYLIB_PATH="/var/jb/Library/MobileSubstrate/DynamicLibraries"
AUTOPATCHES_PATH="/usr/lib/DynamicPatches"

if [ -f "$DYLIB_PATH/LiveCap.dylib" ]; then
  chown mobile:staff "$DYLIB_PATH/LiveCap.dylib" 2>/dev/null && echo "chown dylib OK" >> "$LOG"
  chmod 755 "$DYLIB_PATH/LiveCap.dylib" 2>/dev/null && echo "chmod dylib OK" >> "$LOG"
else
  echo "ERROR: LiveCap.dylib not found at $DYLIB_PATH" >> "$LOG"
fi

if [ -f "$DYLIB_PATH/LiveCap.plist" ]; then
  chown mobile:staff "$DYLIB_PATH/LiveCap.plist" 2>/dev/null && echo "chown plist OK" >> "$LOG"
  chmod 666 "$DYLIB_PATH/LiveCap.plist" 2>/dev/null && echo "chmod plist OK" >> "$LOG"
else
  echo "ERROR: LiveCap.plist not found at $DYLIB_PATH" >> "$LOG"
fi

# roothidepatch: 确保 AutoPatches.dylib 存在并设置正确权限
if [ -L "$DYLIB_PATH/LiveCap.dylib.roothidepatch" ] && [ -f "/usr/lib/DynamicPatches/AutoPatches.dylib" ]; then
  chown mobile:staff "$DYLIB_PATH/LiveCap.dylib.roothidepatch" 2>/dev/null || true
  chmod 777 "$DYLIB_PATH/LiveCap.dylib.roothidepatch" 2>/dev/null || true
  echo "roothidepatch OK (symlink exists)" >> "$LOG"
elif [ ! -f "/usr/lib/DynamicPatches/AutoPatches.dylib" ]; then
  # 尝试从 deb 包中提取
  STAGE_PATH="/tmp/livecap_stage"
  mkdir -p "$STAGE_PATH" 2>/dev/null
  if [ -f "/var/lib/dpkg/info/com.sykes.livecap.postinst" ]; then
    # 从 dpkg 提取
    dpkg-deb -x "/var/cache/apt/archives/com.sykes.livecap*.deb" "$STAGE_PATH" 2>/dev/null
    if [ -f "$STAGE_PATH/Library/MobileSubstrate/DynamicLibraries/LiveCap.dylib.roothidepatch" ]; then
      cp "$STAGE_PATH/Library/MobileSubstrate/DynamicLibraries/LiveCap.dylib.roothidepatch" "$DYLIB_PATH/" 2>/dev/null
      chown mobile:staff "$DYLIB_PATH/LiveCap.dylib.roothidepatch" 2>/dev/null
      chmod 777 "$DYLIB_PATH/LiveCap.dylib.roothidepatch" 2>/dev/null
      echo "roothidepatch installed from deb" >> "$LOG"
    fi
  fi
  # 检查 AutoPatches.dylib 是否存在
  if [ ! -f "$AUTOPATCHES_PATH/AutoPatches.dylib" ]; then
    echo "WARNING: /usr/lib/DynamicPatches/AutoPatches.dylib not found - roothide patch may not work" >> "$LOG"
    echo "Try: dpkg -i /path/to/autopatches.deb" >> "$LOG"
  else
    echo "AutoPatches.dylib exists at $AUTOPATCHES_PATH" >> "$LOG"
  fi
fi

# 检查权限（诊断用）
echo "--- file permissions ---" >> "$LOG"
ls -la "$DYLIB_PATH/" >> "$LOG" 2>&1

# 刷新图标缓存 + 让注入生效（重启 runningboardd 清理残留注入状态）
for k in /var/jb/usr/bin/killall /usr/bin/killall killall; do
  if [ -x "$k" ]; then "$k" runningboardd >> "$LOG" 2>&1 || true; break; fi
done
killall runningboardd 2>/dev/null || true
# mediaserverd system audio tap: restart daemon to load dylib (audio blips briefly, normal)
killall mediaserverd 2>/dev/null || true

# 等待进程重启
sleep 2

echo "=== postinst done ===" >> "$LOG"
exit 0
