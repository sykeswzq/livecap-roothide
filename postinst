#!/bin/sh
# postinst v2.2.3 —— 预写默认配置 + 确保 Filter 权限 + 刷新缓存
LOG=/var/mobile/Documents/livecap_install.log
mkdir -p /var/mobile/Documents
chmod 777 /var/mobile/Documents
echo "=== postinst $(date) ===" > "$LOG"

CFG=/var/mobile/Library/Preferences/com.sykes.livecap.plist
if [ ! -f "$CFG" ]; then
  cat > "$CFG" << 'CFGEOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>enabled</key>
	<true/>
	<key>apiBase</key>
	<string>https://apihub.agnes-ai.cn/v1</string>
	<key>apiKey</key>
	<string></string>
	<key>model</key>
	<string>agnes-3.0-flash</string>
	<key>streamASR</key>
	<true/>
	<key>strictSubtitleSync</key>
	<true/>
	<key>asrEngine</key>
	<string>16k_en</string>
	<key>asrAppId</key>
	<string>1312073434</string>
	<key>fontSize</key>
	<string>16</string>
	<key>asrChunkSeconds</key>
	<real>1.5</real>
	<key>boldText</key>
	<false/>
	<key>textColorHex</key>
	<string>#FFFFFFFF</string>
	<key>backgroundStyle</key>
	<string>frost</string>
	<key>showBilingual</key>
	<false/>
	<key>manualPositions</key>
	<dict/>
</dict>
</plist>
CFGEOF
  chmod 666 "$CFG"
  echo "config written" >> "$LOG"
fi

if [ -f "$CFG" ]; then
  chmod 666 "$CFG"
  echo "config ensured" >> "$LOG"
fi

killall -9 cfprefsd 2>/dev/null || true
# v2.2.18：Preferences 进程会缓存【已加载的 PreferenceBundle 二进制】。
# 只 kill cfprefsd 不够 —— 装完新版后设置里仍显示旧面板（用户实机反馈
# 「字体还是滑块、不能输入」正是这个）。杀掉 Preferences，下次打开设置
# 才会强制重新加载新版 bundle。Sileo 是独立进程，不受影响。
killall -9 Preferences 2>/dev/null || true

DYLIB_PATH="/var/jb/Library/MobileSubstrate/DynamicLibraries"
AUTOPATCHES_DIR="/usr/lib/DynamicPatches"
AUTOPATCHES_FILE="$AUTOPATCHES_DIR/AutoPatches.dylib"

if [ -f "$DYLIB_PATH/LiveCap.dylib" ]; then
  chown mobile:staff "$DYLIB_PATH/LiveCap.dylib" 2>/dev/null && echo "chown dylib OK" >> "$LOG"
  chmod 755 "$DYLIB_PATH/LiveCap.dylib" 2>/dev/null && echo "chmod dylib OK" >> "$LOG"
else
  echo "ERROR: LiveCap.dylib not found at $DYLIB_PATH" >> "$LOG"
fi

if [ -f "$DYLIB_PATH/LiveCap.plist" ]; then
  chown mobile:staff "$DYLIB_PATH/LiveCap.plist" 2>/dev/null && echo "chown plist OK" >> "$LOG"
  chmod 666 "$DYLIB_PATH/LiveCap.plist" 2>/dev/null && echo "chmod plist OK" >> "$LOG"
else
  echo "ERROR: LiveCap.plist not found at $DYLIB_PATH" >> "$LOG"
fi

# v2.2.4：注入系统读取的 Filter 目录必须让 mobile 可写。
# 已注入 App 内的 dylib 以 mobile 身份运行，写 Filter 用的是
# writeToFile:atomically:YES —— 原子写入会在该目录创建临时文件，需要目录写权限；
# 目录若是 755 root，mobile 创建临时文件会被拒绝（"filter sync: write failed"）。
# 把目录改成 777 后，dylib 才能成功改写 Bundles（勾选/取消勾选才会真正生效）。
# 注意：这是 jbroot 内的私有 tweak 目录，777 仅放开同机 app 对其的写权限，可接受。
chmod 777 "$DYLIB_PATH" 2>/dev/null && echo "chmod dynlib dir 777 OK" >> "$LOG" \
  || echo "WARN: chmod dynlib dir 777 failed" >> "$LOG"

# v2.2.5：升版后从偏好 selectedApps 重建 Filter，避免打包默认 Filter（28 bundle、无 com.look.avbox）
# 覆盖掉用户勾选。否则 deb 重装会把默认 Filter 写回，导致暮色等不在默认表里的 App 重开不被注入
# （鸡生蛋：Filter 无它 -> 不注入 -> dylib 不跑 -> 不补写）。设备无 python，这里用 plutil -convert xml1
# 把偏好转 XML 后 awk 抽 selectedApps，过滤 com.apple.*/springboard 重建 Filter。
# 若偏好里还没有 selectedApps（首次安装、面板未打开过），则保留打包默认 Filter，交给 dylib 首次启动补齐。
CFG_PLIST="/var/mobile/Library/Preferences/com.sykes.livecap.plist"
if [ -f "$CFG_PLIST" ]; then
  cp "$CFG_PLIST" /tmp/lc_prefs_xml 2>/dev/null
  plutil -convert xml1 /tmp/lc_prefs_xml 2>/dev/null
  APPS=$(awk "/<key>selectedApps<\/key>/ {f=1;next} f&&/<\/array>/ {f=0} f&&/<string>/ {gsub(/<\\/?string>/,\"\");print}" /tmp/lc_prefs_xml 2>/dev/null)
  rm -f /tmp/lc_prefs_xml
  if [ -n "$APPS" ]; then
    NRAW=$(echo "$APPS" | grep -c .)
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0">'
      echo '<dict>'
      echo '  <key>Filter</key>'
      echo '  <dict>'
      echo '    <key>Bundles</key>'
      echo '    <array>'
      for a in $APPS; do
        case "$a" in
          com.apple.*|*springboard*) continue;;
          *) echo "      <string>$a</string>";;
        esac
      done
      echo '    </array>'
      echo '    <key>Mode</key>'
      echo '    <string>Any</string>'
      echo '  </dict>'
      echo '</dict>'
      echo '</plist>'
    } > "$DYLIB_PATH/LiveCap.plist"
    chown mobile:staff "$DYLIB_PATH/LiveCap.plist" 2>/dev/null || true
    chmod 666 "$DYLIB_PATH/LiveCap.plist" 2>/dev/null || true
    echo "Filter rebuilt from selectedApps (raw=$NRAW) -> $DYLIB_PATH/LiveCap.plist" >> "$LOG"
  else
    echo "selectedApps empty/absent, keep packaged Filter" >> "$LOG"
  fi
else
  echo "prefs plist absent, keep packaged Filter" >> "$LOG"
fi

# v2.2.2：Filter 必须是 666，由「已注入 App 内的 dylib」（mobile 身份）改写 Bundles。
# roothide 下 /var/jb 在「设置」面板（未注入）进程里是影子视图、写会被沙盒拒绝，
# 只有 libroothide 注入后的 App 才能写到真实的 .jbroot 目录。
# 故面板只写 selectedApps 偏好 + notify_post，Filter 实际由 dylib 代写（详见 LiveCap.m）。
# 这里确保文件权限为 666 即可，让 dylib 后续能写。
FILTER_CWD="Library/MobileSubstrate/DynamicLibraries/LiveCap.plist"
FILTER_REL="$(dirname "$0")/../../Library/MobileSubstrate/DynamicLibraries/LiveCap.plist"
for fp in "$FILTER_CWD" "$FILTER_REL"; do
  if [ -f "$fp" ]; then
    chown mobile:staff "$fp" 2>/dev/null || true
    chmod 666 "$fp" 2>/dev/null && echo "chmod filter OK (relative): $fp" >> "$LOG"
  else
    echo "WARN: filter not found (relative): $fp" >> "$LOG"
  fi
done

ROOTHIDE_PATCH="$DYLIB_PATH/LiveCap.dylib.roothidepatch"
if [ ! -L "$ROOTHIDE_PATCH" ]; then
  ln -sf "$AUTOPATCHES_FILE" "$ROOTHIDE_PATCH" 2>/dev/null
  if [ -L "$ROOTHIDE_PATCH" ]; then
    chown mobile:staff "$ROOTHIDE_PATCH" 2>/dev/null
    chmod 777 "$ROOTHIDE_PATCH" 2>/dev/null
    echo "roothidepatch symlink created" >> "$LOG"
  else
    echo "ERROR: Failed to create roothidepatch symlink" >> "$LOG"
  fi
else
  echo "roothidepatch symlink exists" >> "$LOG"
fi

if [ ! -f "$AUTOPATCHES_FILE" ]; then
  echo "WARNING: AutoPatches.dylib not found at $AUTOPATCHES_FILE" >> "$LOG"
else
  echo "AutoPatches.dylib found at $AUTOPATCHES_FILE" >> "$LOG"
fi

LDID=""
for l in /usr/bin/ldid /var/jb/usr/bin/ldid /var/jb/usr/sbin/ldid; do
  [ -x "$l" ] && LDID="$l" && break
done
if [ -n "$LDID" ]; then
  echo "ldid found: $LDID" >> "$LOG"
  for f in "$DYLIB_PATH/LiveCap.dylib" \
           "/var/jb/Library/PreferenceBundles/LiveCapPrefs.bundle/LiveCapPrefs"; do
    if [ -f "$f" ]; then
      "$LDID" -S "$f" >> "$LOG" 2>&1 && echo "re-sign OK: $f" >> "$LOG" \
        || echo "re-sign FAILED: $f" >> "$LOG"
    fi
  done
else
  echo "WARNING: ldid not found, cannot re-sign dylib" >> "$LOG"
fi

JBC=""
for j in /usr/bin/jbctl /basebin/jbctl /var/jb/usr/bin/jbctl; do
  [ -x "$j" ] && JBC="$j" && break
done
if [ -n "$JBC" ] && [ -f "$DYLIB_PATH/LiveCap.dylib" ]; then
  TC_TARGETS=""
  for jb in /var/containers/Bundle/Application/.jbroot-*; do
    [ -d "$jb" ] && TC_TARGETS="$TC_TARGETS $jb/usr/lib/TweakInject/LiveCap.dylib"
  done
  TC_TARGETS="$TC_TARGETS $DYLIB_PATH/LiveCap.dylib"
  TC_OK=0
  for t in $TC_TARGETS; do
    [ -f "$t" ] || continue
    if "$JBC" trustcache add "$t" >> "$LOG" 2>&1; then
      echo "trustcache add OK: $t" >> "$LOG"
      TC_OK=1
      break
    else
      echo "trustcache add failed for: $t" >> "$LOG"
    fi
  done
  [ "$TC_OK" = "0" ] && echo "WARNING: trustcache add failed for all paths" >> "$LOG"
fi

echo "--- file permissions ---" >> "$LOG"
ls -la "$DYLIB_PATH/" >> "$LOG" 2>&1

for k in /var/jb/usr/bin/killall /usr/bin/killall killall; do
  if [ -x "$k" ]; then "$k" runningboardd >> "$LOG" 2>&1 || true; break; fi
done
killall runningboardd 2>/dev/null || true

sleep 2
echo "=== postinst done ===" >> "$LOG"
exit 0
